.venv/
__pycache__/
*.pyc
work/

# Rendered packages. Built on main from committed code, never tracked.
outputs/
.omc/
.pytest_cache/
.DS_Store
.fallow/churn.bin

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.fallow/

# A traced sheet is kept unpacked; the export bundle beside it is the same
# files again, so it is not tracked.
motions/*.zip

# A bundle's source clip is cut again by `cag clips` from the recorded source;
# the manifest's clip block, which describes it, is tracked.
motions/**/clip.mp4
